# Copy to .env.local. Never commit real values.
# Local values come from `npx supabase status` after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for: demo bootstrap script, admin account disable/invite, deletion processing.
# Never prefix with NEXT_PUBLIC_ and never import from a client component.
SUPABASE_SECRET_KEY=
# Public origin of this app (used for auth redirect links and canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo bootstrap safety switches (scripts/bootstrap-demo.mjs). Local/staging only.
DEMO_MODE=false
# Must be set to the exact string below to confirm a non-production target.
DEMO_TARGET_CONFIRM=
# Comma-separated hostnames treated as production; bootstrap refuses to run against them.
PRODUCTION_SUPABASE_HOSTS=
